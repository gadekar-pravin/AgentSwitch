# Copy to .env and fill in locally. Never commit .env.
# The platform URLs are in the course brief; the login email and passwords are posted in the team
# channel. Each business has its own password.

# suryodaya (India) or keystone (US)
AS_TENANT=suryodaya
AS_URL_SURYODAYA=
AS_URL_KEYSTONE=

AS_EMAIL=
AS_PASSWORD_SURYODAYA=
AS_PASSWORD_KEYSTONE=

# Agent model, called through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
